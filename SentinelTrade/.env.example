# Aplicacao
APP_ENV=dev
APP_PORT=8080

# Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SentinelTrade
DB_USER=nome-do-usuario
DB_PASSWORD=senha-local

# Autenticacao e MFA
JWT_SECRET=segredo-placeholder
JWT_EXPIRATION_SECONDS=1800
MFA_ISSUER=SentinelTrade
MFA_CODE_VALIDITY_SECONDS=30
MFA_MAX_ATTEMPTS=5

# Cotacoes Simuladas
QUOTES_URL=http://localhost:1234
QUOTES_KEY=
QUOTES_TIMEOUT_SECONDS=1

# Bolsa Simulada
EXCHANGE_URL=http://localhost:5678
EXCHANGE_KEY=
EXCHANGE_TIMEOUT_SECONDS=1

# Resiliencia
ORDER_MAX_RETRIES=3
ORDER_RETRY_INTERVAL_SECONDS=1
ORDER_IDEMPOTENCY_TTL_SECONDS=3600

# Auditoria
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit